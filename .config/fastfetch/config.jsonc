{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
	"source": "~/.config/fastfetch/logos/$(bash ~/.config/fastfetch/get_os.sh).txt",
	"padding": {
	    "top": 2
	}
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭──────────── SYSTEM",
            "type": "custom"
        },
        {
            "key": "├─ 󰌽 OS ❯{#keys}",
            "type": "os",
            "format": "{name}"
        },
        {           
            "key": "├─ 󰇅 Host ❯{#keys}",
            "type": "host",
            "format": "{vendor} {name}"
        },
        {
            "key": "├─ 󰍛 CPU ❯{#keys}",
            "type": "cpu",
            "format": "{name}",
            "showPeCoreCount": false
        },
        {
            "key": "╰─  RAM ❯{#keys}",
            "type": "memory",
            "format": "{total}"
        },
        {
            "key": "╭──────────── USER",
            "type": "custom"
        },
        {
            "key": "├─  User ❯{#keys}",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "├─  Window Manager ❯{#keys}",
            "type": "wm",
            "format": "{1}"
        },
        {
            "key": "├─  Terminal ❯{#keys}",
            "type": "terminal",
            "format": "{pretty-name}"
        },
        {
            "key": "╰─  Shell ❯{#keys}",
            "type": "shell",
            "format": "{1}"
        }
    ]
}
